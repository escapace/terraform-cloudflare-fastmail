{
  "name": "terraform-cloudflare-fastmail",
  "version": "0.0.0",
  "author": {
    "name": "escapace",
    "email": "opensource@escapace.com"
  },
  "bugs": "https://github.com/escapace/terraform-cloudflare-fastmail/issues",
  "devDependencies": {
    "@commitlint/cli": "20.5.0",
    "@commitlint/config-conventional": "20.5.0",
    "@escapace/syncpack-configuration": "0.1.0",
    "@ls-lint/ls-lint": "2.3.1",
    "eslint": "9.39.4",
    "eslint-config-escapace": "5.14.0",
    "lefthook": "2.1.4",
    "prettier": "3.8.1",
    "prettier-config-escapace": "1.2.2",
    "syncpack": "14.2.0"
  },
  "engines": {
    "pnpm": ">=10.29.2",
    "terraform": ">=1.14.0",
    "tflint": ">=0.61.0",
    "trivy": ">=0.69.3"
  },
  "homepage": "https://github.com/escapace/terraform-cloudflare-fastmail#readme",
  "license": "Apache-2.0",
  "private": true,
  "repository": "escapace/terraform-cloudflare-fastmail",
  "scripts": {
    "docs": "terraform-docs . && prettier --no-error-on-unmatched-pattern --write README.md",
    "format": "syncpack format && eslint --no-warn-ignored --fix && prettier --no-error-on-unmatched-pattern -uw . && terraform fmt -recursive",
    "lint": "pnpm run ls-lint && eslint && pnpm run tflint && pnpm run trivy",
    "ls-lint": "ls-lint --config .ls-lint.yaml",
    "prepare": "lefthook install && terraform init -backend=false -upgrade && tflint --init",
    "syncpack": "syncpack fix && syncpack format",
    "tflint": "tflint --recursive --chdir .",
    "trivy": "trivy fs --scanners misconfig --include-dev-deps --skip-dirs '.terraform/**' --skip-dirs 'examples' .",
    "typecheck": "terraform validate"
  },
  "sideEffects": false,
  "type": "module"
}
